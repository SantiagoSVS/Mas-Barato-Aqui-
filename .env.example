# Copia este archivo como .env y cambia la clave. El archivo .env nunca se sube al repositorio.

# PostgreSQL (lo usa docker-compose.yml para crear el contenedor)
POSTGRES_USER=mas_barato
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=mas_barato_aqui
POSTGRES_PORT=5432

# Conexión del backend. Debe usar los mismos usuario, clave y puerto de arriba.
DATABASE_URL=postgresql+psycopg://mas_barato:cambia_esta_clave@localhost:5432/mas_barato_aqui

# Base de datos aparte para las pruebas (la crea docker/postgres/init al iniciar el contenedor).
# Las pruebas borran y recrean sus tablas: nunca apuntarla a la base de desarrollo.
TEST_DATABASE_URL=postgresql+psycopg://mas_barato:cambia_esta_clave@localhost:5432/mas_barato_aqui_test
